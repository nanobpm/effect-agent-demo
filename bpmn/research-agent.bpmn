      <bpmndi:BPMNShape id="BPMNShape_nudge" bpmnElement="nudge">
        <dc:Bounds x="1266" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_review" bpmnElement="review">
        <dc:Bounds x="1466" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Gw_4" bpmnElement="Gw_4" isMarkerVisible="true">
        <dc:Bounds x="1666" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1665" y="76" width="53" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_publish" bpmnElement="publish">
        <dc:Bounds x="1816" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_record-revision" bpmnElement="record-revision">
        <dc:Bounds x="1816" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_archive" bpmnElement="archive">
        <dc:Bounds x="2016" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_End" bpmnElement="End">
